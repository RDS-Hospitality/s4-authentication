# Copy to .env, fill in, then: set -a; source .env; set +a
S4_AUTH_PROVIDERS=google
S4_AUTH_USER_POOL_ID=
S4_AUTH_CLIENT_ID=
S4_AUTH_COGNITO_DOMAIN=
S4_AUTH_BASE_URL=http://localhost:5050
S4_AUTH_SESSION_BACKEND=memory
# Validation-only: leave unset for the default (30 minutes). Set to e.g. 2 for the S3.1 check.
S4_AUTH_IDLE_TIMEOUT=
